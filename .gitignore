# 배포 설정 (서버 정보, 계정 포함)
.claude/deploy-config.env

# VS Code 워크스페이스 설정 — 머신별 동적 생성 (interpreter 절대경로 박힘)
# template: setup/templates/vscode-settings.template.json (commit)
# install/SessionStart hook 가 자동 생성
.vscode/settings.json
.vscode/*.bak

# 컨텍스트 캐시 (자동 생성)
.claude/context-cache/

# 보안 스캔 결과
docs/secret-scan.txt
docs/security-report.txt

# 임시 문서
docs/lint-result.txt
docs/build-result.txt
docs/test-result.txt
docs/changed-files.txt

# 모니터 결과
docs/monitor-report.md

# node
node_modules/
dist/

# Java 빌드
target/
*.jar
!.claude/scripts/*.jar

# Python
__pycache__/
*.pyc
.env
.env.local

# Task locks (자동 생성)
.claude/tasks/locks/
.claude/tasks/done/
.claude/orca-heartbeat
.claude/orca-enabled
.claude/orca-stopped
.claude/state/

# 설치/테스트 임시 출력
install-test-*.txt

# Large binaries (download separately)
cloudflared.exe

# Setup 빌드 결과물 (setup.exe는 GitHub Releases로 배포)
setup/Output/
setup/innosetup.exe

# Inno Setup 컴파일러 (로컬만)
InnoSetup6/

# Video restore work dirs
_vr_work_*/

# OS
Thumbs.db
Desktop.ini
.DS_Store
\!_TMPRUN!

# 로컬 전용 설정 (PAT 등 시크릿 — GitHub push protection 으로 commit 불가)
docs/ini/

# PC별 권한·경로 설정 (사용자명·작업폴더 차이로 다른 PC에서 안 맞음)
.claude/settings.local.json

# 외부 MCP 런타임 (npx 자동 fetch — 로컬 clone 불필요)
claude-talk-to-figma-mcp/

# 스케줄러 런타임 락 (PID·세션ID — 재시작하면 무의미)
.claude/scheduled_tasks.lock

# Stale task locks
.claude/tasks/locks/*.lock

# Microsoft Office 임시 잠금 파일
~$*.pptx
~$*.docx
~$*.xlsx
# Setup 자동 backup (Module 01 이 기존 .claude 백업할 때 생성)
.claude_backup_*/

# 디자인 ref 작업 log (자동 정리되지만 commit 방지)
docs/screens/_*.log

# nul (Windows redirect 잔재)
/nul
/NUL

# Tool result cache (Claude Code)
.claude/projects/*/tool-results/

# 시스템 log (자동 생성)
.claude/logs/

# 시크릿 파일 (절대 commit 금지)
*.git-credentials
*git-credentials
