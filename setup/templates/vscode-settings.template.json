{
  "python.defaultInterpreterPath": "__PYTHON_PATH__",
  "python.terminal.activateEnvironment": false,
  "python.analysis.indexing": false,
  "python.analysis.autoImportCompletions": false,
  "python.analysis.diagnosticMode": "openFilesOnly",
  "python.analysis.exclude": [
    "**/docs/screens/**",
    "**/docs/deploy-history/**",
    "**/.claude/logs/**",
    "**/.claude/state/**",
    "**/.claude/tasks/done/**",
    "**/.claude/context-cache/**",
    "**/outputs/**",
    "**/archive/**",
    "**/node_modules/**",
    "**/.git/**"
  ],
  "files.watcherExclude": {
    "**/docs/screens/**": true,
    "**/docs/deploy-history/**": true,
    "**/.claude/logs/**": true,
    "**/.claude/state/**": true,
    "**/.claude/tasks/done/**": true,
    "**/.claude/tasks/locks/**": true,
    "**/.claude/context-cache/**": true,
    "**/.claude/tool-results/**": true,
    "**/outputs/**": true,
    "**/archive/**": true,
    "**/node_modules/**": true,
    "**/.git/objects/**": true,
    "**/__pycache__/**": true,
    "**/*.pyc": true
  },
  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/*.pyc": true,
    "**/.claude/logs": true,
    "**/.claude/state/cache": true
  },
  "search.exclude": {
    "**/docs/screens": true,
    "**/docs/deploy-history": true,
    "**/.claude/logs": true,
    "**/.claude/state": true,
    "**/.claude/tasks/done": true,
    "**/.claude/context-cache": true,
    "**/outputs": true,
    "**/archive": true,
    "**/node_modules": true,
    "**/__pycache__": true,
    "**/*.pyc": true
  },
  "search.followSymlinks": false,
  "search.useIgnoreFiles": true,
  "telemetry.telemetryLevel": "off",
  "extensions.autoUpdate": false,
  "extensions.autoCheckUpdates": false,
  "git.autorefresh": false,
  "git.autofetch": false,
  "git.decorations.enabled": false,
  "scm.diffDecorations": "none",
  "editor.minimap.enabled": false,
  "editor.bracketPairColorization.enabled": false,
  "editor.semanticHighlighting.enabled": false,
  "editor.largeFileOptimizations": true,
  "workbench.enableExperiments": false,
  "workbench.editor.limit.enabled": true,
  "workbench.editor.limit.value": 8,
  "workbench.editor.limit.perEditorGroup": true,
  "typescript.tsserver.maxTsServerMemory": 1024,
  "typescript.disableAutomaticTypeAcquisition": true,
  "files.maxMemoryForLargeFilesMB": 2048,
  "terminal.integrated.gpuAcceleration": "off"
}
