/**
 * Layout — Sidebar + Topbar + Content (앱 전역)
 * 반응형 (모바일 drawer) · 다크모드 · 접근성
 */
import * as React from "react";
import { Menu, X, Bell, Search, User } from "lucide-react";
import { Button } from "./core";

interface AppShellProps {
  sidebar: React.ReactNode;
  topbarRight?: React.ReactNode;
  children: React.ReactNode;
  logo?: React.ReactNode;
  title?: string;
}

export function AppShell({ sidebar, topbarRight, children, logo, title = "앱" }: AppShellProps) {
  const [mobileOpen, setMobileOpen] = React.useState(false);
  return (
    <div className="flex h-screen w-full bg-slate-50 dark:bg-slate-950">
      {/* 모바일 drawer backdrop */}
      {mobileOpen && (
        <div
          className="fixed inset-0 z-[1100] bg-black/50 lg:hidden"
          onClick={() => setMobileOpen(false)}
          aria-hidden
        />
      )}

      {/* === SIDEBAR === */}
      <aside
        className={`fixed inset-y-0 left-0 z-[1150] w-64 transform border-r bg-white dark:bg-slate-900 dark:border-slate-800 transition-transform lg:static lg:translate-x-0 ${
          mobileOpen ? "translate-x-0" : "-translate-x-full lg:translate-x-0"
        }`}
        aria-label="사이드바"
      >
        <div className="flex h-16 items-center justify-between border-b px-4 dark:border-slate-800">
          <div className="flex items-center gap-2 font-semibold">
            {logo}
            <span>{title}</span>
          </div>
          <Button variant="ghost" size="icon" className="lg:hidden" onClick={() => setMobileOpen(false)} aria-label="메뉴 닫기">
            <X className="h-5 w-5" />
          </Button>
        </div>
        <nav className="flex-1 overflow-y-auto p-4">{sidebar}</nav>
      </aside>

      {/* === MAIN === */}
      <div className="flex flex-1 flex-col overflow-hidden">
        {/* TOPBAR */}
        <header className="flex h-16 items-center justify-between border-b bg-white px-4 dark:bg-slate-900 dark:border-slate-800">
          <Button variant="ghost" size="icon" className="lg:hidden" onClick={() => setMobileOpen(true)} aria-label="메뉴 열기">
            <Menu className="h-5 w-5" />
          </Button>
          <div className="flex flex-1 items-center gap-4 pl-4">
            {/* Search slot */}
          </div>
          <div className="flex items-center gap-2">
            {topbarRight ?? (
              <>
                <Button variant="ghost" size="icon" aria-label="알림"><Bell className="h-5 w-5" /></Button>
                <Button variant="ghost" size="icon" aria-label="프로필"><User className="h-5 w-5" /></Button>
              </>
            )}
          </div>
        </header>

        {/* CONTENT */}
        <main className="flex-1 overflow-auto p-4 sm:p-6 lg:p-8" tabIndex={-1}>
          {children}
        </main>
      </div>
    </div>
  );
}

/* ============================================================
 * Container — 중앙 정렬 + max-width
 * ============================================================ */
export function Container({ className, ...p }: React.HTMLAttributes<HTMLDivElement>) {
  return <div className={`mx-auto w-full max-w-7xl ${className ?? ""}`} {...p} />;
}

/* ============================================================
 * Grid — 반응형 N 열
 * ============================================================ */
interface GridProps extends React.HTMLAttributes<HTMLDivElement> {
  cols?: 1 | 2 | 3 | 4 | 6 | 12;
  gap?: 2 | 3 | 4 | 6 | 8;
}
export function Grid({ cols = 3, gap = 4, className, ...p }: GridProps) {
  const colsMap = {
    1: "grid-cols-1",
    2: "grid-cols-1 sm:grid-cols-2",
    3: "grid-cols-1 sm:grid-cols-2 lg:grid-cols-3",
    4: "grid-cols-1 sm:grid-cols-2 lg:grid-cols-4",
    6: "grid-cols-2 sm:grid-cols-3 lg:grid-cols-6",
    12: "grid-cols-4 sm:grid-cols-6 lg:grid-cols-12",
  };
  return <div className={`grid ${colsMap[cols]} gap-${gap} ${className ?? ""}`} {...p} />;
}

/* ============================================================
 * PageHeader — 페이지 제목 + 설명 + 액션
 * ============================================================ */
interface PageHeaderProps {
  title: string;
  description?: string;
  actions?: React.ReactNode;
  breadcrumbs?: React.ReactNode;
}
export function PageHeader({ title, description, actions, breadcrumbs }: PageHeaderProps) {
  return (
    <div className="mb-6">
      {breadcrumbs && <div className="mb-2">{breadcrumbs}</div>}
      <div className="flex items-start justify-between gap-4">
        <div>
          <h1 className="text-2xl font-bold tracking-tight sm:text-3xl">{title}</h1>
          {description && <p className="mt-1 text-sm text-slate-600 dark:text-slate-400">{description}</p>}
        </div>
        {actions && <div className="flex items-center gap-2">{actions}</div>}
      </div>
    </div>
  );
}
