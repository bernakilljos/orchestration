/**
 * Dashboard Pattern — 운영 바로 사용 가능
 * Sidebar + Topbar + KPI 4 + Chart 2 + Table
 * npm install: recharts (경량) or echarts-for-react (고성능)
 */
import * as React from "react";
import { AppShell, Container, Grid, PageHeader } from "../components/Layout.tsx.template";
import { Card, CardHeader, CardTitle, CardContent } from "../components/core.tsx.template";
import { LineChart, Line, BarChart, Bar, XAxis, YAxis, Tooltip, ResponsiveContainer, CartesianGrid } from "recharts";
import { TrendingUp, Users, DollarSign, Activity, Home, FileText, Settings } from "lucide-react";

interface KpiProps {
  label: string;
  value: string | number;
  change?: number;
  icon?: React.ReactNode;
}

function Kpi({ label, value, change, icon }: KpiProps) {
  const isPositive = (change ?? 0) >= 0;
  return (
    <Card>
      <CardContent className="pt-6">
        <div className="flex items-start justify-between">
          <div>
            <p className="text-sm font-medium text-slate-600 dark:text-slate-400">{label}</p>
            <p className="mt-1 text-3xl font-bold">{value}</p>
            {change !== undefined && (
              <p className={`mt-1 text-xs ${isPositive ? "text-green-600" : "text-red-600"}`}>
                {isPositive ? "▲" : "▼"} {Math.abs(change)}% 전월 대비
              </p>
            )}
          </div>
          {icon && <div className="rounded-md bg-blue-50 p-2 text-blue-600 dark:bg-blue-900/30">{icon}</div>}
        </div>
      </CardContent>
    </Card>
  );
}

export default function Dashboard() {
  const kpiData = [
    { label: "총 매출", value: "₩128,540,000", change: 12.5, icon: <DollarSign className="h-5 w-5" /> },
    { label: "활성 사용자", value: "4,382", change: 8.2, icon: <Users className="h-5 w-5" /> },
    { label: "전환율", value: "3.42%", change: -1.1, icon: <TrendingUp className="h-5 w-5" /> },
    { label: "응답 속도", value: "245ms", change: -15.3, icon: <Activity className="h-5 w-5" /> },
  ];

  const trendData = [
    { date: "1월", 매출: 42, 비용: 28 },
    { date: "2월", 매출: 48, 비용: 30 },
    { date: "3월", 매출: 55, 비용: 32 },
    { date: "4월", 매출: 62, 비용: 35 },
    { date: "5월", 매출: 71, 비용: 38 },
    { date: "6월", 매출: 85, 비용: 42 },
  ];

  const categoryData = [
    { 카테고리: "A", 수량: 450 },
    { 카테고리: "B", 수량: 320 },
    { 카테고리: "C", 수량: 280 },
    { 카테고리: "D", 수량: 180 },
  ];

  const sidebar = (
    <ul className="flex flex-col gap-1">
      <li><a href="#" className="flex items-center gap-2 rounded-md px-3 py-2 text-sm font-medium bg-blue-50 text-blue-600"><Home className="h-4 w-4" /> 대시보드</a></li>
      <li><a href="#" className="flex items-center gap-2 rounded-md px-3 py-2 text-sm text-slate-700 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800"><FileText className="h-4 w-4" /> 문서</a></li>
      <li><a href="#" className="flex items-center gap-2 rounded-md px-3 py-2 text-sm text-slate-700 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800"><Settings className="h-4 w-4" /> 설정</a></li>
    </ul>
  );

  return (
    <AppShell sidebar={sidebar} title="관리자">
      <Container>
        <PageHeader
          title="대시보드"
          description="2026년 10월 운영 지표 요약"
        />

        <Grid cols={4} gap={4} className="mb-6">
          {kpiData.map((k) => <Kpi key={k.label} {...k} />)}
        </Grid>

        <Grid cols={2} gap={6} className="mb-6">
          <Card>
            <CardHeader><CardTitle>월별 매출·비용 추이</CardTitle></CardHeader>
            <CardContent>
              <ResponsiveContainer width="100%" height={300}>
                <LineChart data={trendData}>
                  <CartesianGrid strokeDasharray="3 3" opacity={0.3} />
