{
  "schema_version": "1.1",
  "name": "orchestration-kit",
  "display_name": "Multi-AI Orchestration Kit",
  "version": "3.1.0",
  "description": "Claude + Codex + Gemini 멀티AI 오케스트레이션 킷 — 설계·구현·검증 파이프라인 자동화",
  "author": "bernakilljos",
  "repository": "https://github.com/bernakilljos/orchestration",

  "entry_points": {
    "session_start": "exec_orca-auto",
    "task_route":    "route_dispatch",
    "state_save":    "state_session",
    "learning":      "exec_learning"
  },

  "pipeline": {
    "standard": [
      "Hook      → 사전 확인 (파일 잠금·충돌·MCP 체크)",
      "Planner   → Claude 구조 설계 (task-instruction.md)",
      "Executor  → Codex 구현 (codex-auto 4개)",
      "Validator → Gemini 검증 (gemini-auto 2개)",
      "State     → 스냅샷 저장 (.claude/context-cache/)",
      "Retry     → 실패 시 3회 재시도 후 Claude 에스컬레이션"
    ],
    "design_ppt":   ["Claude → Canva → Mermaid → Figma"],
    "design_excel": ["Claude → openpyxl → 차트 → Google Sheets"],
    "design_word":  ["Claude → python-docx → Mermaid → PDF"],
    "voice":        ["마이크/파일 → Whisper STT → Claude 분석 → edge-tts TTS"],
    "learning":     ["작업 완료 → Claude 패턴 추출 → JSON 저장 → 다음 세션 활용"]
  },

  "plugins": {
    "exec_orch":    "plugins/exec_orch/",
    "exec_voice":   "plugins/exec_voice/",
    "exec_learning":"plugins/exec_learning/",
    "design_ppt":   "plugins/design_ppt/",
    "design_excel": "plugins/design_excel/",
    "design_word":  "plugins/design_word/",
    "review_qa":    "plugins/review_qa/",
    "mcp_dev":      "plugins/mcp_dev/",
    "mcp_data":     "plugins/mcp_data/",
    "mcp_collab":   "plugins/mcp_collab/",
    "mcp_web":      "plugins/mcp_web/",
    "mcp_docs":     "plugins/mcp_docs/",
    "mcp_media":    "plugins/mcp_media/"
  },

  "prefix_convention": {
    "exec_":   "실행 계열 — 작업 수행·부트스트랩",
    "design_": "디자인/문서/PPT/시각화 계열",
    "review_": "검증·리뷰·품질 계열",
    "route_":  "라우팅·판단·분기 계열",
    "state_":  "상태 저장·복구 계열",
    "hook_":   "훅 관련 계열",
    "bridge_": "외부 AI 연동 계열",
    "mcp_":    "MCP 설치·연결 계열"
  },

  "workers": {
    "codex":       { "bat": "codex-auto.bat",  "count": 4, "role": "구현" },
    "gemini":      { "bat": "gemini-auto.bat", "count": 2, "role": "검증" },
    "claude":      { "bat": "claude-auto.bat", "count": 3, "role": "보완" },
    "config":      ".claude/orca-workers-config.json",
    "task_dir":    ".claude/tasks/"
  },

  "state": {
    "orca_flags":  ".claude/",
    "new_state":   ".claude/state/",
    "snapshot":    ".claude/context-cache/session-snapshot.md",
    "learning":    ".claude/learning/"
  },

  "hooks": {
    "config":      ".claude/hooks/hooks.json",
    "scripts_dir": ".claude/hooks/",
    "runtime":     ".claude/settings.json"
  },

  "codex": {
    "instructions": "AGENTS.md",
    "config":       ".codex/config.toml",
    "mcp_servers":  ["filesystem", "github", "playwright", "figma", "canva", "mermaid"]
  }
}
