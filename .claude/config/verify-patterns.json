{
  "_meta": {
    "purpose": "범용 테스트 결과 검증 contract (P0b H6+H7 · 2026-10-28)",
    "근거": "하드코딩 감사 H6 (긍정 신호 nUnit 누락) + H7 (금지 패턴 14개 하드코딩)",
    "원칙": "PASS 단순 포함 X · word boundary + 프레임워크별 패턴 + fail-closed · 새 프레임워크 추가 시 이 JSON 만 수정",
    "지원 프레임워크": "pytest · unittest · cargo (Rust) · jest · mocha · xunit (NET) · nunit · go test · phpunit · rspec · generic",
    "last_updated": "2026-10-28"
  },
  "positive_patterns": [
    {"pattern": "\\bPASS(ED)?\\b", "framework": "generic", "note": "대문자 PASS/PASSED"},
    {"pattern": "\\bOK\\b", "framework": "unittest", "note": "Python unittest, Rust test harness"},
    {"pattern": "\\bpassed\\b", "framework": "pytest", "note": "소문자 passed (pytest·jest)"},
    {"pattern": "[1-9][0-9]*\\s+(?:tests?|checks?|cases?)\\s+passed", "framework": "generic", "note": "N tests passed"},
    {"pattern": "all\\s+(?:tests?|checks?)\\s+passed", "framework": "generic", "note": "all tests passed"},
    {"pattern": "test result:\\s*ok\\b", "framework": "cargo", "note": "Rust cargo test"},
    {"pattern": "ran\\s+\\d+\\s+tests?\\s+in", "framework": "unittest", "note": "Python unittest 요약"},
    {"pattern": "^OK\\s*\\(", "framework": "unittest", "note": "unittest OK (N) 형식"},
    {"pattern": "✓\\s+\\d+\\s+passing", "framework": "mocha", "note": "mocha ✓ N passing"},
    {"pattern": "Tests:\\s+\\d+\\s+passed", "framework": "jest", "note": "jest Tests: N passed"},
    {"pattern": "PASS\\s+Test\\s+run\\s+successful", "framework": "xunit", "note": ".NET xUnit"},
    {"pattern": "ok\\s+\\d+\\s+-\\s+", "framework": "tap", "note": "TAP ok N - desc"},
    {"pattern": "\"passed\"\\s*:\\s*[1-9][0-9]*", "framework": "pytest-json", "note": "pytest JSON passed > 0"},
    {"pattern": "\"status\"\\s*:\\s*\"(?:verified|pass|ok|success)\"", "framework": "generic-json", "note": "JSON status 긍정"}
  ],
  "negative_patterns": [
    "\\bFAILED\\b",
    "\\bFAIL\\b(?!\\s*=\\s*[0 ])",
    "\"failed\"\\s*:\\s*[1-9]",
    "(?i)\\bnot\\s+ok\\b",
    "(?i)\\b[1-9]\\d*\\s+failed\\b",
    "(?i)\\bexception\\b",
    "(?i)\\btraceback\\b",
    "(?i)\\bcritical\\b",
    "(?i)\\bfatal\\b",
    "(?i)\\b0\\s+passed\\b",
    "(?i)\\bno\\s+tests?\\s+(ran|collected)\\b",
    "(?i)but\\s+errors?\\s+found",
    "(?i)but\\s+failed",
    "(?i)failures:",
    "(?i)assertion\\s+(error|failed)",
    "(?i)aborted",
    "(?i)did\\s+not\\s+pass",
    "(?i)errored",
    "(?i)errors\\)",
    "(?i)panic",
    "(?i)crash",
    "(?i)test\\s+result:\\s*fail",
    "(?i)Tests?:\\s+[1-9]\\d*\\s+failed"
  ],
  "pytest_json_pass_pattern": "\"passed\"\\s*:\\s*[1-9][0-9]*.*?\"failed\"\\s*:\\s*0\\b",
  "_notes": [
    "positive_patterns 는 하나라도 매치되면 긍정 신호 (word boundary 또는 프레임워크 특정 형식)",
    "negative_patterns 는 하나라도 매치되면 즉시 FAIL (fail-closed)",
    "pytest_json_pass_pattern 은 혼재 반례 (passed=1, failed=1) 완전 통과 확인용 early positive",
    "새 프레임워크 추가 시 positive_patterns 에만 추가 (코드 수정 X)",
    "negative 는 보수적으로 유지 (오탐 보다 fail-closed 우선)"
  ]
}
